cask "licecap"               # animated GIF screen recorder
cask "logitech-options"
cask "rambox"                # unified messaging app (Slack, email, etc.)
cask "raycast"               # launcher and productivity tool, replaces Spotlight
cask "spotify"
cask "visual-studio-code"
